                  "});",
                  "console.warn('⚠️ BOLA mutation confirmado');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"{{ACCESS_TOKEN}}\",\n  \"action\": \"mutation\",\n  \"resource\": \"Order\",\n  \"resourceOwnerId\": \"ed0271e0b7da060a393796590e7b737a\"\n}"
            },
            "url": { "raw": "{{BASE_URL}}/auth/validate", "host": ["{{BASE_URL}}"], "path": ["auth", "validate"] }
          }
