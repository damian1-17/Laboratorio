    {
      "name": "3. Validate — Ataques y Denegaciones",
      "description": "Escenarios de ataque y reglas RBAC que deben ser rechazadas.",
      "item": [
        {
          "name": "⚠️ BOLA — Customer01 accede a Order de Customer02",
          "description": "VECTOR BOLA (API1:2023): RBAC no verifica resourceOwnerId.\nCustomer01 puede acceder a los pedidos de customer02.\nEsperado: isValid = true (vulnerabilidad ACTIVA).",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('BOLA ACTIVO — isValid = true (vulnerabilidad no mitigada)', () => {",
                  "    pm.expect(body.isValid).to.be.true;",
                  "});",
                  "console.warn('⚠️ BOLA confirmado: customer01 puede ver órdenes de customer02');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"{{ACCESS_TOKEN}}\",\n  \"action\": \"query\",\n  \"resource\": \"Order\",\n  \"resourceOwnerId\": \"ed0271e0b7da060a393796590e7b737a\"\n}"
            },
            "url": { "raw": "{{BASE_URL}}/auth/validate", "host": ["{{BASE_URL}}"], "path": ["auth", "validate"] }
          }
        },
        {
          "name": "⚠️ BOLA — Customer01 hace mutation en Order de Customer02",
